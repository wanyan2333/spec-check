+def test_list_todos_with_limit():
+    for title in ["a", "b", "c"]:
+        client.post("/todos", json={"title": title})
+    response = client.get("/todos", params={"limit": 2})
+    assert response.status_code == 200
+    assert [t["title"] for t in response.json()] == ["a", "b"]
